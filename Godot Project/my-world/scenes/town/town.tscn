render_mode unshaded;
void fragment() {
	float s = fract(UV.y * 3.0 - TIME * 2.0);
	ALBEDO = mix(vec3(0.6, 0.9, 1.0), vec3(1.0), smoothstep(0.8, 1.0, s));
	ALPHA = 0.8;
}"

