; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MyWorld"
run/main_scene="res://scenes/title/title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Clock="*res://scripts/clock.gd"
Game="*res://scripts/game.gd"
Audio="*res://scripts/audio.gd"
Settings="*res://scripts/settings.gd"
Dialogue="*res://scripts/dialogue.gd"
Quests="*res://scripts/quests.gd"
TownMap="*res://scripts/map_screen.gd"
Shop="*res://scripts/shop.gd"
Creator="*res://scripts/creator.gd"
Tips="*res://scripts/tips.gd"
SkateLesson="*res://scripts/skate_lesson.gd"
PauseMenu="*res://scripts/pause_menu.gd"
PlayerMenu="*res://scripts/player_menu.gd"
Watches="*res://scripts/watches.gd"
Requests="*res://scripts/requests.gd"
EarthJobs="*res://scripts/earth_jobs.gd"
Festival="*res://scripts/festival.gd"
EarthTown="*res://scripts/earth_town.gd"
Arsenal="*res://scripts/arsenal.gd"
Races="*res://scripts/races.gd"
FirstNight="*res://scripts/first_night.gd"
Juice="*res://scripts/juice.gd"
Soundscape="*res://scripts/soundscape.gd"
Nights="*res://scripts/nights.gd"
Playtest="*res://scripts/playtest.gd"
Loading="*res://scripts/loading_screen.gd"
Schematics="*res://scripts/schematics.gd"
Bosses="*res://scripts/bosses.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false

