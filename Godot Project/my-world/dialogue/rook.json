{
  "name": "Rook",
  "conversations": [
    {
      "when": {
        "quest_step": "first_night:shift"
      },
      "lines": [
        "...woof.",
        "{player}: He's hiding his eyes. Poor Rook."
      ]
    },
    {
      "when": {
        "flag": "rex_home",
        "every": 2
      },
      "rotate": [
        [
          "WOOF!",
          "{player}: He's chasing his tail! He's THRILLED."
        ],
        [
          "Awoooo!",
          "{player}: Zoom! Rex's old paw skates!"
        ]
      ]
    },
    {
      "when": {
        "quest_step": "dog_rights:sign",
        "not_flag": "dogs_sign_rook"
      },
      "lines": [
        "Woof?",
        "{player}: Will you sign the Doggie Bill of Rights?",
        "Woof! WOOF!",
        "{player}: A muddy paw print! Best signature yet!"
      ],
      "set": "dogs_sign_rook"
    },
    {
      "when": {
        "talks": 0
      },
      "lines": [
        "Grrr...",
        "{player}: Um... hi? Are you okay?",
        "Woof.",
        "{player}: Is that a yes woof or a no woof?",
        "...Woof.",
        "{player}: That's a 'not really' woof."
      ]
    },
    {
      "when": {
        "quest_step": "rex_lab:rook"
      },
      "lines": [
        "{player}: He's sniffing my humming watch.",
        "Woof?",
        {
          "choice": [
            {
              "text": "Rook, will you come to the lab?",
              "lines": [
                "{player}: Ears flat. He remembers the lab."
              ]
            },
            {
              "text": "There's a ball at the lab, Rook!",
              "set": "lab_rook",
              "lines": [
                "WOOF! WOOF WOOF!",
                "{player}: He's off to the lab like a rocket!"
              ]
            },
            {
              "text": "Good boy, Rex!",
              "lines": [
                "{player}: Oops. Far away, a husky shouts \"I'M REX!\""
              ]
            }
          ]
        }
      ]
    },
    {
      "when": {
        "quest_step": "rex_lab:try"
      },
      "lines": [
        "Woof! Wag wag!"
      ]
    },
    {
      "when": {
        "quest_step": "rex_campaign:ask",
        "not_flag": "asked_rook"
      },
      "set": "asked_rook",
      "lines": [
        "{player}: Rook, what should a mayor do?",
        "Grrr... grumble grumble...",
        "{player}: Every voice counts. Even grumbly ones.",
        "...Woof.",
        "{player}: More naps in the sun? Got it."
      ]
    },
    {
      "when": {
        "time": "shift"
      },
      "lines": [
        "Awoooooo!",
        "{player}: He's howling at the portal."
      ]
    },
    {
      "when": {
        "activity": "napping"
      },
      "lines": [
        "Zzzz... snrrk... woof... zzzz.",
        "{player}: Sun nap. I'll let him sleep."
      ]
    },
    {
      "when": {
        "activity": "following",
        "every": 2
      },
      "lines": [
        "Woof!",
        "{player}: Following them again? Good brother-dog.",
        "Hmph."
      ]
    },
    {
      "when": {
        "activity": "grumbling",
        "every": 2
      },
      "lines": [
        "Grrr... grumble grumble...",
        "{player}: Grumbling at the moon again?",
        "Woof."
      ]
    },
    {
      "when": {
        "time": "night",
        "every": 2
      },
      "lines": [
        "Zzz... woof... zzz...",
        "{player}: Sweet dreams, Rook."
      ]
    },
    {
      "when": {
        "time": "morning",
        "every": 2
      },
      "lines": [
        "Woof! Woof!",
        "{player}: Good morning to you too!"
      ]
    },
    {
      "rotate": [
        [
          "Grrr...",
          "{player}: Grumpy? I'd be grumpy too in a new shape.",
          "Hmph."
        ],
        [
          "Woof?",
          {
            "choice": [
              {
                "text": "Want a belly rub?",
                "lines": [
                  "GRRR!",
                  "{player}: No belly rubs. Got it."
                ]
              },
              {
                "text": "Want to play fetch?",
                "lines": [
                  "Woof! Woof!",
                  "{player}: His whole body's wagging! That's a yes."
                ]
              }
            ]
          }
        ],
        [
          "Woof.",
          "{player}: Rex says HE's Rex and you're the dog.",
          "GRRR.",
          "{player}: Yeah. I figured."
        ]
      ]
    }
  ]
}
