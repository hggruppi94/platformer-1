{
  "name": "Pip",
  "conversations": [
    {
      "when": {
        "quest_step": "first_night:shift"
      },
      "lines": [
        "Oh! Hi. I'm Pip. Did you fall out of the sky too?",
        "I was lighting lanterns at home... then CRACK!",
        "The little aliens are very... huggy."
      ]
    },
    {
      "when": {
        "quest_step": "slide_mystery:why",
        "not_flag": "slide_ask_pip"
      },
      "lines": [
        "The old slide?",
        "I heard a whoosh there... and a giggle. Nobody was there!"
      ],
      "set": "slide_ask_pip"
    },
    {
      "when": {
        "quest_step": "dog_rights:sign",
        "not_flag": "dogs_sign_pip"
      },
      "lines": [
        "I'd LOVE to sign! Rook is a very good dog."
      ],
      "set": "dogs_sign_pip"
    },
    {
      "when": {
        "quest_step": "turtle_independence:wake"
      },
      "lines": [
        "My wings feel like flippers today!",
        "Every version of me can do something!"
      ]
    },
    {
      "night_2": true,
      "when": {
        "quest_step": "night_2:pip",
        "quest_not_started": "pip_lamps"
      },
      "set": "n2_pip",
      "lines": [
        "{player}! I waited by the portal for you!",
        "Let's make moon-lamps, so nobody's scared of the dark!",
        "They need five glow shells from round the lake.",
        {
          "choice": [
            {
              "text": "I'll find them!",
              "set": "pip_lamps_start",
              "lines": [
                "YAY! Look near the water!",
                "And find the S-K-A-T-E letters in the Skate Park!"
              ]
            },
            {
              "text": "Maybe in a bit.",
              "lines": [
                "Okay! Shells are very patient."
              ]
            }
          ]
        }
      ]
    },
    {
      "night_2": true,
      "when": {
        "quest_step": "night_2:pip"
      },
      "set": "n2_pip",
      "lines": [
        "{player}! I waited by the portal for you!",
        "Find the S-K-A-T-E letters in the Skate Park!"
      ]
    },
    {
      "when": {
        "talks": 0
      },
      "lines": [
        "Oh! Hi! I'm Pip. Are you a lamp? You're kind of glowy.",
        "{player}: I'm {player}. Not a lamp.",
        "Aw. Still nice, though."
      ]
    },
    {
      "when": {
        "quest_done": "rex_campaign",
        "quest_not_started": "pip_lamps",
        "min_talks": 1
      },
      "lines": [
        "{player}! I want to make moon-lamps NOW!",
        "They need five glow shells from round the lake.",
        {
          "choice": [
            {
              "text": "I'll find them!",
              "set": "pip_lamps_start",
              "lines": [
                "YAY! Look near the water!"
              ]
            },
            {
              "text": "Maybe another time.",
              "lines": [
                "Okay! Shells are very patient."
              ]
            }
          ]
        }
      ]
    },
    {
      "when": {
        "quest_step": "pip_lamps:find"
      },
      "lines": [
        "Any glow shells yet? Look by the water!"
      ]
    },
    {
      "when": {
        "quest_step": "pip_lamps:bring"
      },
      "set": "pip_got_shells",
      "lines": [
        "{player}: Pip! I found all five glow shells!",
        "OHHH. So glowy!",
        "(The boardwalk lanterns light up like little moons!)",
        "Now nobody has to be scared of the dark!",
        "I'm LAMPLIGHTER Pip now!"
      ]
    },
    {
      "when": {
        "quest_done": "pip_lamps",
        "time": [
          "evening",
          "night"
        ],
        "every": 2
      },
      "lines": [
        "The moon-lamps are still glowing!"
      ]
    },
    {
      "when": {
        "quest_step": "rex_campaign:ask",
        "not_flag": "asked_pip"
      },
      "set": "asked_pip",
      "lines": [
        "{player}: What would you want a mayor to do?",
        "MORE LAMPS! So nobody's scared of the dark!"
      ]
    },
    {
      "when": {
        "time": "shift"
      },
      "lines": [
        "The portal is the glowiest light EVER."
      ]
    },
    {
      "when": {
        "activity": "lamp_watching",
        "travelling": true
      },
      "lines": [
        "The lamps are coming on! See you!"
      ]
    },
    {
      "when": {
        "activity": "asleep",
        "travelling": true
      },
      "lines": [
        "(yawn) Night night, {player}."
      ]
    },
    {
      "when": {
        "activity": "lamp_watching",
        "place": "market",
        "every": 2
      },
      "lines": [
        "The market lamps stand in a circle. A lamp party!"
      ]
    },
    {
      "when": {
        "time": "morning"
      },
      "lines": [
        "(yawn) Too bright..."
      ]
    },
    {
      "when": {
        "time": "day"
      },
      "lines": [
        "Zzz...",
        "{player}: ...Pip's asleep standing up."
      ]
    },
    {
      "when": {
        "time": "evening",
        "every": 2
      },
      "lines": [
        "The lamps are coming on! Best part of the day!"
      ]
    },
    {
      "rotate": [
        [
          "Lamp! Lamp! That lamp is SO round."
        ],
        [
          "Want to go lamp watching?",
          {
            "choice": [
              {
                "text": "Sure!",
                "lines": [
                  "Yay! That one's my favourite."
                ]
              },
              {
                "text": "Maybe later.",
                "lines": [
                  "Okay! Lamps are very patient."
                ]
              }
            ]
          }
        ],
        [
          "I tried to count the boardwalk lamps. Too exciting!"
        ]
      ]
    }
  ]
}
